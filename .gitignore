# Virtual Environment
.venv/
venv/
ENV/

# Python Cache
__pycache__/
*.py[cod]
*$py.class

# Runtime SQLite Database & logs
data/*.db
data/*.db-shm
data/*.db-wal
data/*.log

# GGUF AI Models (Files > 100MB cannot be pushed to standard git repo; downloaded automatically via setup script or release)
models/*.gguf
models/*.part
!models/.gitkeep

# AI Engine Binaries (Pre-compiled DLLs and EXEs downloaded automatically via setup script or release)
engine/


# Node & Frontend dependencies
node_modules/
frontend/node_modules/
frontend/.vite/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Binary distribution archives (attached to GitHub Releases)
*.zip

